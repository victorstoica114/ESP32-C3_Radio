      "controlled_ppk_median_increase_min_uA": 2000,
      "other_ppk_median_absolute_change_max_uA": 100
    },
    "limits_convention": "byte_start inclusive, byte_end exclusive; word boundaries must be 4-byte aligned; all ranges must be 0..4; sample counts must match the original report."
