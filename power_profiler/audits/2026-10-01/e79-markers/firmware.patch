+/* DIO17 is also JTAG TDI: disconnect a four-wire JTAG probe when using
+ * this measurement image. The signal is generated by the RF core, not UART
+ * timing or a CPU callback around RF_runCmd(). RFC_GPO0/1/3 stay untouched. */
+static void txMarkerIdle(void)
+{
+    GPIO_setConfigAndMux(E79_TX_MARKER_DIO,
+                         GPIO_CFG_OUTPUT | GPIO_CFG_OUT_LOW, IOC_PORT_GPIO);
+}
+
+static void txMarkerPowerUp(RF_Handle handle, RF_CmdHandle command, RF_EventMask events)
+{
+    uint32_t routing;
+    (void)handle;
+    (void)command;
+
+    if ((events & RF_EventPowerUp) == 0U) {
+        return;
+    }
+
+    /* SDK 8.33.00.16 calls pPowerCb after radio setup has completed. The
+     * global RadioSetup event is earlier and its register writes could be
+     * overwritten by setup. Reapply on every wake/profile reopen, preserving
+     * the other fields used by antenna/PA control. */
+    routing = HWREG(RFC_DBELL_BASE + RFC_DBELL_O_SYSGPOCTL);
+    routing = (routing & ~RFC_DBELL_SYSGPOCTL_GPOCTL2_M)
+            | RFC_DBELL_SYSGPOCTL_GPOCTL2_RATGPO0;
+    HWREG(RFC_DBELL_BASE + RFC_DBELL_O_SYSGPOCTL) = routing;
+    GPIO_setConfigAndMux(E79_TX_MARKER_DIO, GPIO_CFG_NO_DIR, IOC_PORT_RFC_GPO2);
+}
+
+/* Override only the generated application's weak hook. SysConfig calls its
+ * separate antenna-switching callback as before. Never touch RF registers
+ * after power-down; put the marker pin in a known low GPIO state instead. */
+void rfDriverCallback(RF_Handle handle, RF_GlobalEvent events, void *arg)
+{
+    (void)handle;
+    (void)arg;
+    if (events & (RF_GlobalEventInit | RF_GlobalEventRadioPowerDown)) {
+        txMarkerIdle();
+    }
+}
