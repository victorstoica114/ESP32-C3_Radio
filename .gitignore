.vscode/launch.json
.vscode/ipch/
compile_commands.json

# Build artifacts
*.bin
*.elf
*.hex
*.map
*.factory.bin

# Local test logs
log/

# Python power-profiler environment and generated measurements
.tmp/
# All local PPK captures, wire streams, manifests and relocation inventories.
/measurements/raw/
/measurements/relocation.json
# A capture must never become tracked because of an explicit output directory.
*.csv.gz
*.ppk2.bin
*.ppk
*.ppk2
# Older explicit output paths remain local; new defaults use measurements/raw/.
power_profiler/.venv/
power_profiler/pilot_results/
power_profiler/results/
power_profiler/web_sessions/
power_profiler/diagnostics/
power_profiler/**/__pycache__/
power_profiler/**/*.pyc

# Local alternate PlatformIO core used for callback-safe firmware builds
.pio-callback-core/

# Copied RA-08 SDK local/heavy artifacts
src/RA-08(ASR6601)/.git/
src/RA-08(ASR6601)/.gitmodules
src/RA-08(ASR6601)/tools/toolchain/
src/RA-08(ASR6601)/tools/toolchain/*.zip
src/RA-08(ASR6601)/**/out/
src/RA-08(ASR6601)/**/*.uvguix.*
src/RA-08(ASR6601)/**/*.uvoptx

